# Configuración de entorno para Vino Nuevo
# Copia este archivo a .env y completa los valores

# Modo de ejecución: development | production
FLASK_ENV=development

# Clave secreta para sesiones (genera una segura para producción)
SECRET_KEY=dev-secret-key-change-in-production

# Base de datos MySQL (para cuando la uses)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=serv_comunitario

# Configuración de la app
APP_HOST=0.0.0.0
APP_PORT=5000

# Configuración de debug
DEBUG=True

# Datos demo: solo se usan en desarrollo cuando la BD no está disponible
MOCK_MODE=False