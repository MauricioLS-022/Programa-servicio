# =============================================================================
# Configuración de Entorno — Proyecto Vino Nuevo
# Copia este archivo a .env y ajusta los valores según tu entorno
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Modo de Ejecución
# -----------------------------------------------------------------------------
# development: Habilita recarga automática, modo demo (si no hay BD) y banners de prueba.
# production:  Exige variables obligatorias (Fail-Fast), desactiva DEBUG, desactiva MOCK_MODE,
#              obliga el uso de cookies seguras (HTTPS) y bloquea cualquier fallback demo.
FLASK_ENV=development

# -----------------------------------------------------------------------------
# 2. Clave Secreta de Sesión (SECRET_KEY)
# -----------------------------------------------------------------------------
# OBLIGATORIA en producción. Mínimo 32 caracteres criptográficos.
# Para generar una clave criptográfica segura en terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA uses 'dev-secret-key-change-in-production' en producción.
SECRET_KEY=dev-secret-key-change-in-production

# -----------------------------------------------------------------------------
# 3. Conexión a Base de Datos MySQL (PyMySQL)
# -----------------------------------------------------------------------------
# En producción, TODAS las siguientes variables son estrictamente obligatorias.
# En producción, DB_PASSWORD NO puede ser vacía.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=serv_comunitario
DB_TIMEOUT=5.0
DB_SSL=true

# -----------------------------------------------------------------------------
# 4. Configuración del Servidor y Depuración
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=5000

# En producción, DEBUG se forza automáticamente a False por seguridad.
DEBUG=True

# -----------------------------------------------------------------------------
# 5. Google reCAPTCHA (v2 / v3)
# -----------------------------------------------------------------------------
# OBLIGATORIAS en producción para proteger el formulario de autenticación anti-bots.
RECAPTCHA_SITE_KEY=tu_site_key_aqui
RECAPTCHA_SECRET_KEY=tu_secret_key_aqui

# -----------------------------------------------------------------------------
# 6. Modo Mock / Demo (SOLO DESARROLLO)
# -----------------------------------------------------------------------------
# Si está en True, aísla la base de datos y usa mock_data en desarrollo.
# En producción, este valor se forza estrictamente a False (no tiene efecto).
MOCK_MODE=False

